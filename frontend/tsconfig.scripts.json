{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Same resolution strategy as tsconfig.app.json (bundler) since this
       project imports directly from src/ (layoutCore.ts and its deps),
       and it's built with esbuild's own bundler-style resolution too — not
       Node's own module resolution rules (nodenext, used by
       tsconfig.node.json for vite.config.ts), which would fight the
       "verbatimModuleSyntax" default-import style already used in src/. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts"]
}
